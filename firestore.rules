rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper to check if current authenticated user is SuperAdmin
    function isSuperAdmin() {
      return request.auth != null && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isSuperAdmin == true) ||
        request.auth.token.email == 'cemmil2000@gmail.com' ||
        request.auth.token.email.matches('.*admin.*')
      );
    }

    // ==========================================
    // USERS
    // Users can read/write their own document; SuperAdmins can manage all
    // ==========================================
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());
      allow delete: if request.auth != null && isSuperAdmin();
    }

    // ==========================================
    // GROUPS
    // Members can read, admin or SuperAdmin can modify/delete
    // ==========================================
    match /groups/{groupId} {
      allow read: if request.auth != null && (isMemberOfGroup(groupId) || isSuperAdmin());
      allow create: if request.auth != null;
      allow update: if request.auth != null && (isAdminOfGroup(groupId) || isSuperAdmin());
      allow delete: if request.auth != null && (isAdminOfGroup(groupId) || isSuperAdmin());

      // Group members subcollection
      match /members/{memberId} {
        allow read: if request.auth != null && (isMemberOfGroup(groupId) || isSuperAdmin());
        allow create: if request.auth != null && (
          isAdminOfGroup(groupId) ||
          request.auth.uid == memberId ||
          isSuperAdmin()
        );
        allow update: if request.auth != null && (
          isAdminOfGroup(groupId) ||
          request.auth.uid == memberId ||
          isSuperAdmin()
        );
        allow delete: if request.auth != null && (
          isAdminOfGroup(groupId) ||
          request.auth.uid == memberId ||
          isSuperAdmin()
        );
      }
    }

    // ==========================================
    // PRODUCTS
    // Members or SuperAdmins can read/manage
    // ==========================================
    match /products/{productId} {
      allow read: if request.auth != null && (isMemberOfGroup(resource.data.groupId) || isSuperAdmin());
      allow create: if request.auth != null && (
        isMemberOfGroup(request.resource.data.groupId) ||
        isSuperAdmin()
      );
      allow delete: if request.auth != null && (isAdminOfGroup(resource.data.groupId) || isSuperAdmin());
      allow update: if request.auth != null && (
        isMemberOfGroup(resource.data.groupId) ||
        isSuperAdmin()
      );

      // Purchase history subcollection
      match /history/{recordId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update, delete: if false;
      }
    }

    // ==========================================
    // CLEANING TASKS
    // ==========================================
    match /cleaningTasks/{taskId} {
      allow read: if request.auth != null && (isMemberOfGroup(resource.data.groupId) || isSuperAdmin());
      allow create: if request.auth != null && (isMemberOfGroup(request.resource.data.groupId) || isSuperAdmin());
      allow delete: if request.auth != null && (isAdminOfGroup(resource.data.groupId) || isSuperAdmin());
      allow update: if request.auth != null && (isMemberOfGroup(resource.data.groupId) || isSuperAdmin());

      // Cleaning history subcollection
      match /history/{recordId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update, delete: if false;
      }
    }

    // ==========================================
    // NOTIFICATIONS
    // ==========================================
    match /notifications/{notifId} {
      allow read: if request.auth != null && 
        resource.data.recipientUid == request.auth.uid;
      allow create: if request.auth != null;
      allow update: if request.auth != null && 
        resource.data.recipientUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow delete: if false;
    }

    // ==========================================
    // SYSTEM BROADCASTS & AUDIT LOGS
    // ==========================================
    match /system_broadcasts/{broadcastId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /admin_audit_logs/{logId} {
      allow read, write: if isSuperAdmin();
    }

    // ==========================================
    // HELPER FUNCTIONS
    // ==========================================

    function isMemberOfGroup(groupId) {
      return exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }

    function isAdminOfGroup(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)).data.adminUid == request.auth.uid;
    }

    function isMemberOfProductGroup(productId) {
      let product = get(/databases/$(database)/documents/products/$(productId));
      return isMemberOfGroup(product.data.groupId);
    }

    function isAdminOfProductGroup(productResource) {
      return isAdminOfGroup(productResource.data.groupId);
    }

    function isCurrentBuyerOfProduct(productId) {
      let product = get(/databases/$(database)/documents/products/$(productId));
      let currentIndex = product.data.currentTurnIndex;
      let rotationOrder = product.data.rotationOrder;
      return rotationOrder[currentIndex % rotationOrder.size()] == request.auth.uid;
    }

    function isMemberOfTaskGroup(taskId) {
      let task = get(/databases/$(database)/documents/cleaningTasks/$(taskId));
      return isMemberOfGroup(task.data.groupId);
    }
  }
}
